# Dockerfile para produção
FROM python:3.11-slim

WORKDIR /app

# Atualizar e instalar dependências do sistema
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Instalar Nuclei
RUN curl -sL https://github.com/projectdiscovery/nuclei/releases/latest/download/nuclei_linux_amd64.zip | \
    zcat > /usr/local/bin/nuclei && \
    chmod +x /usr/local/bin/nuclei

# Instalar templates do Nuclei (atualiza na primeira execução)
# Rodar nuclei -update-templates manualmente ou no startup

# Copiar requirements e instalar
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt gunicorn

# Copiar código
COPY app/ ./app/

# Criar arquivo de banco
RUN touch /app/rootx.db

# Expor porta
ENV PORT=8000
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:$PORT/api/health || exit 1

# Comando com Gunicorn para produção
CMD ["sh", "-c", "nuclei -update-templates 2>/dev/null; gunicorn app.main:app -w 2 -k uvicorn.workers.UvicornWorker -b 0.0.0.0:$PORT"]
